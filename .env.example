# Cloudflare
# Token: dash.cloudflare.com -> Profile -> API Tokens
# Quyen can: D1:Edit, Workers:Edit, Pages:Edit, R2:Edit, Zone:Edit (neu dung domain rieng)
CF_API_TOKEN=your_cloudflare_api_token
CF_ACCOUNT_ID=your_account_id
CF_ZONE_ID=

# Ten du an (khong dau, khong khoang trang)
WORKER_NAME=giapha-api
PAGES_PROJECT=giapha
D1_DB_NAME=giapha-db
R2_BUCKET=giapha-media

# Ma admin goc - dat chuoi ngau nhien manh
ADMIN_KEY=change_me_strong_key_here

# Domain rieng (de trong = dung *.pages.dev)
DOMAIN=

# Sao luu GitHub (tuy chon)
GH_TOKEN=
GH_USER=
GH_REPO=
